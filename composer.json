{
  "name": "jengo/storage",
  "description": "Modern, unified filesystem abstraction, asset management, and image pipeline for CodeIgniter 4 and the Jengo Framework.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Ian Ochieng",
      "email": "ochiengian383@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "codeigniter4/framework": "^4.6|^4.7",
    "jengo/base": "^1.1|dev-main",
    "league/flysystem": "^3.0",
    "league/flysystem-aws-s3-v3": "^3.0",
    "league/flysystem-memory": "^3.0"
  },
  "suggest": {
    "jengo/schema": "Required for building automatic file attachment and asset relations in database schema models"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../base"
    }
  ],
  "autoload": {
    "psr-4": {
      "Jengo\\Storage\\": "src/"
    },
    "files": [
      "src/Helpers/storage_helper.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "test": "phpunit --no-coverage --colors=always"
  }
}
